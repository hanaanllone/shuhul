# The address comes from SITE_ADDRESS. Given a host name, Caddy fetches and
# renews an HTTPS certificate for it by itself. ":80" means plain HTTP.
{$SITE_ADDRESS::80} {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	# Built files carry a hash in their name, so they can be kept for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
}
