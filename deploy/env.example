# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# Session signing key: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_hex(32))"
SHUHUL_SECRET_KEY=

# Password for the database container. Letters and digits only.
#   python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=

# The address people open the site at, e.g. https://d1234abcd.cloudfront.net
FRONTEND_ORIGIN=

# Folder on this machine that holds the processed district data.
SHUHUL_DATA_DIR=/srv/shuhul-data/processed

# Map tiles are served by the API under /api/tiles and cached by the CDN.
SHUHUL_TILE_BASE_URL=/api/tiles

# Hours between re-reading the news outlets. 0 turns it off.
SHUHUL_WATCH_REFRESH_HOURS=3

# Amazon Bedrock, for analysing reports. Leave the model empty to keep it off.
AWS_REGION=ap-south-1
SHUHUL_BEDROCK_MODEL_ID=
