# development or production. Production refuses to start without a real secret.
SHUHUL_ENV=development

# Session signing key: at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SHUHUL_SECRET_KEY=

# Origins allowed to call the API, comma-separated.
FRONTEND_ORIGIN=http://localhost:5173

# Leave unset to use a local SQLite file at backend/shuhul.db.
# SHUHUL_DATABASE_URL=postgresql+psycopg2://shuhul:password@localhost:5432/shuhul

# Leave unset to use processed/ and outputs/ in the project folder.
# SHUHUL_PROCESSED_ROOT=
# SHUHUL_OUTPUT_ROOT=

SHUHUL_DEFAULT_DISTRICT=sxr

# 1: the API runs analyses itself (development default).
# 0: a separate worker does, started with: python -m backend.worker
# SHUHUL_INLINE_WORKER=1
